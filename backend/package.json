{
  "name": "ticketmaestro-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --var AI_MODE:offline --var PASSWORD_RESET_MODE:local",
    "dev:ai": "node scripts/dev-ai.js",
    "test": "node --test",
    "evaluate:ai": "node scripts/evaluate-ai.js",
    "evaluate:jev": "node scripts/evaluate-ai.js --model typesafe/jev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "6.2.18",
    "swagger-ui-dist": "5.36.0"
  },
  "devDependencies": {
    "wrangler": "^4.59.0"
  }
}
