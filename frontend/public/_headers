# Apply security headers to all static asset paths. Keep the CSP connect-src origin aligned with
# config.js so requests can reach the API.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; connect-src 'self' http://localhost:8787; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
